# Copy this file to .env and fill in your key. Never commit .env.

# Your OpenRouter key (from openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# IMPORTANT: the Agent SDK speaks Anthropic's protocol, so it uses
# https://openrouter.ai/api  (NOT the OpenAI-style /api/v1 URL).
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Model for the agent. Haiku 5.5 is very cheap, good for building and testing.
# Switch to a Sonnet model for the final recorded demo if Haiku's tone is weaker.
JIC_MODEL=anthropic/claude-haiku-5.5
# JIC_MODEL=~anthropic/claude-sonnet-latest

# Hard stop per session, in US dollars (the SDK ends the run if exceeded).
JIC_MAX_BUDGET_USD=0.50
